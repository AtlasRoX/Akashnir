# ---------------------------------------------------------------------------
# Akashnir documentary - keep the repo to scripts, notes and small assets.
# All footage and every rendered film stay out of git.
# ---------------------------------------------------------------------------

# Source clips (camera, phone and drone footage: 1.mp4 ... 54-1.mp4, *.MTS)
*.mp4
*.MP4
*.mts
*.MTS
*.m2ts
*.mov
*.MOV
*.avi
*.mkv

# Final versions (already covered by *.mp4 above; listed so it is explicit)
Akashnir_ChadBagan_Documentary_1080p.mp4
Akashnir_ChadBagan_Documentary_v2_1080p.mp4
Akashnir_ChadBagan_Documentary_v3_1080p.mp4
Akashnir_ChadBagan_Documentary_*.mp4

# Heavy rendered intermediates (regenerated by the _production scripts).
# stills/, text/ titles and test frames are small and stay tracked; these two
# folders are not: shots/ is ~600 MB of graded clips and render/ holds 64 MB mixes,
# which would push the repo toward GitHub's size limits on every re-render.
_production/shots/
_production/render/
*.wav

# Music: Scott Buckley, CC BY 4.0 - re-download from scottbuckley.com.au
_production/music/

# Python
__pycache__/
*.pyc

# OS clutter
Thumbs.db
desktop.ini
.DS_Store
